    .main-container {
      margin: 100px auto;
      background: rgba(10, 10, 25, 0.9);
      border-radius: 30px;
      padding: 60px;
      width: 90%;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      backdrop-filter: blur(10px);
      box-shadow: 0 0 10px rgba(0, 255, 255, 0.1);
      transition: box-shadow 0.3s ease;
    }

    .main-container:hover {
      box-shadow: 0 0 40px rgba(0, 255, 255, 0.6);
    }

    .left {
      flex: 1;
      min-width: 300px;
    }

    .left h1 {
      font-size: 20px;
      margin-bottom: 10px;
    }

    .left h2 {
      color: #00d2ff;
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .left p {
      color: #ccc;
      font-size: 36px;
      font-weight: 600;
      font-family:'Times New Roman', Times, serif;
      margin-bottom: 30px;
    }

    .buttons {
      display: flex;
      gap: 20px;
    }

    .buttons button {
      padding: 12px 24px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      font-size: 14px;
      transition: 0.3s ease;
    }

    .btn-primary {
      background: #00d2ff;
      color: #000;
    }

    .btn-outline {
      background: transparent;
      border: 2px solid #00d2ff;
      color: #00d2ff;
    }

    .buttons button:hover {
      transform: translateY(-3px);
    }

    .right img {
      width: 400px;
      height: 400px;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid #00d2ff;
    }

    @media (max-width: 768px) {
      .main-container {
        flex-direction: column;
        text-align: center;
      }

      .right {
        margin-top: 30px;
      }
    }
  </style>
